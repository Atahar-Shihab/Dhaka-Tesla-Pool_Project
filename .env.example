# ============================================
# Dhaka Tesla Pool - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file!

# Database
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=dhaka_tesla_pool
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/dhaka_tesla_pool

# JWT (JSON Web Token) - used for user login sessions
JWT_SECRET=your_super_secret_key_change_this
JWT_EXPIRES_IN=7d

# Server
PORT=5000
NODE_ENV=development

# Client
VITE_API_URL=http://localhost:5000/api
